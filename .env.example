# ============================================================
#  KAIHARA OS — Environment Variables (Production)
# ============================================================
#  Copy to .env and fill in values before deployment
# ============================================================

# RootSys Cloud API Key
ROOTSYS_API_KEY=your_rootsys_api_key_here

# Dashboard Password (optional)
DASHBOARD_PASSWORD=

# Telegram Bot Token (optional)
TELEGRAM_BOT_TOKEN=

# Email Settings (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
