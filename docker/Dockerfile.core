# Kaihara Core Dockerfile
FROM python:3.12-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    git curl wget nmap dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir psutil python-telegram-bot aiosmtplib

# Playwright
RUN playwright install chromium 2>/dev/null || true

# Copy app
COPY . .

# Environment
ENV PYTHONPATH=/app
ENV OLLAMA_HOST=http://kaihara-llm:11434

EXPOSE 7000

CMD ["python", "main.py"]
